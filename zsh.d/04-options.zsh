# Shell options
setopt AUTO_CD                 # cd by typing directory name
setopt AUTO_PUSHD              # Auto push directories
setopt PUSHD_IGNORE_DUPS       # Ignore duplicates in pushd
setopt INTERACTIVE_COMMENTS    # Allow comments in interactive shell
setopt NO_BEEP                 # Disable beep
setopt EXTENDED_GLOB           # Extended globbing
setopt GLOB_DOTS               # Include dotfiles in globbing
setopt COMPLETE_IN_WORD        # Complete from both ends
setopt ALWAYS_TO_END           # Move cursor to end after completion
setopt CORRECT                 # Auto-correct typos
setopt COMPLETE_ALIASES        # Complete aliases
setopt NO_NOMATCH              # Don't error on no match
setopt LIST_TYPES              # Show file types in list
setopt AUTO_REMOVE_SLASH       # Remove trailing slash
setopt NULL_GLOB               # Don't error on empty glob
